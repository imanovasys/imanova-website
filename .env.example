# Required for the Contact Us form (app/api/contact/route.ts) to send email
# through your Zoho Mail account.
#
# ZOHO_SMTP_USER: the full mailbox address, e.g. info@imanovasys.com
# ZOHO_SMTP_PASSWORD: a Zoho *app-specific* password (not your normal login
#   password) — generate one at Zoho Mail > Settings > Security > App Passwords.
# ZOHO_SMTP_HOST: optional, only needed if your Zoho account isn't on the
#   default .com data center (use smtp.zoho.eu, smtp.zoho.in, etc. as needed).
#
# In Vercel: Project Settings -> Environment Variables -> add each one.
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_SMTP_HOST=
